# Entorno de producción en HostGator.
APP_ENV=production
APP_DEBUG=false

# Tiempo máximo de inactividad de una sesión autenticada, en segundos.
SESSION_TIMEOUT=1800

# URL pública de la aplicación, sin barra final.
APP_URL=https://mangoapp.co/mango-next/public

# Base de datos de producción.
DB_HOST=localhost
DB_PORT=3306
# Nombre de la base y usuario creados en cPanel.
DB_DATABASE=mangoapp_mango_next
DB_USERNAME=mangoapp_mango_next
# Completa la contraseña únicamente en el .env real del servidor.
# Completa esta contraseña únicamente en el .env real de HostGator.
DB_PASSWORD=

# Cuenta de correo creada en cPanel.
MAIL_HOST=mail.mangoapp.co
MAIL_PORT=465
MAIL_USERNAME=no-reply@mangoapp.co
# Escribe aquí la contraseña en el .env real de HostGator, nunca en esta plantilla.
# Completa esta contraseña únicamente en el .env real de HostGator.
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@mangoapp.co
MAIL_FROM_NAME=ManGo!